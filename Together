-- DEFAULT CONFIGURATION
--==================================================

local Config = {
    MasterEnabled = false,

    AutoServerHop = true,
    LockPosition = false,

    AutoTargetEnabled = true,
    AutoFireEnabled = false,
    AutoFireInterval = 0.21,

    X = -3.22,
    Y = 60.40,
    Z = 899.32,

    SafetyDelay = 2,
    HopTimeout = 8,
    EmptyServerDelay = 2
}

local CONFIG_FOLDER = "GorillaKingHunter"
local CONFIG_FILE = CONFIG_FOLDER .. "/Settings.json"

--==================================================
-- LOAD CONFIGURATION
--==================================================

local function LoadConfig()

    if not isfile or not readfile then
        return false
    end

    if not isfile(CONFIG_FILE) then
        return false
    end

    local Success, Data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)

    if not Success or type(Data) ~= "table" then
        return false
    end

    for _, Key in ipairs({
        "AutoServerHop",
        "LockPosition",
        "AutoTargetEnabled",
        "AutoFireEnabled"
    }) do

        if type(Data[Key]) == "boolean" then
            Config[Key] = Data[Key]
        end

    end

    for _, Key in ipairs({
        "X",
        "Y",
        "Z",
        "SafetyDelay",
        "HopTimeout",
        "EmptyServerDelay",
        "AutoFireInterval"
    }) do

        if type(Data[Key]) == "number" then
            Config[Key] = Data[Key]
        end

    end

    Config.AutoFireInterval = math.max(
        0.21,
        Config.AutoFireInterval
    )

    Config.MasterEnabled = false

    return true

end

--==================================================
-- SAVE CONFIGURATION
--==================================================

local function SaveConfig()

    if not writefile then
        return false
    end

    if makefolder then

        if not isfolder or not isfolder(CONFIG_FOLDER) then

            pcall(function()
                makefolder(CONFIG_FOLDER)
            end)

        end

    end

    local Data = {
        AutoServerHop = Config.AutoServerHop,
        LockPosition = Config.LockPosition,

        AutoTargetEnabled = Config.AutoTargetEnabled,
        AutoFireEnabled = Config.AutoFireEnabled,
        AutoFireInterval = Config.AutoFireInterval,

        X = Config.X,
        Y = Config.Y,
        Z = Config.Z,

        SafetyDelay = Config.SafetyDelay,
        HopTimeout = Config.HopTimeout,
        EmptyServerDelay = Config.EmptyServerDelay
    }

    local Success, Error = pcall(function()

        writefile(
            CONFIG_FILE,
            HttpService:JSONEncode(Data)
        )

    end)

    if not Success then
        warn("[Hunter] Configuration save failed:", Error)
        return false
    end

    return true

end

LoadConfig()

